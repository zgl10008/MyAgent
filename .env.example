# 运行模式
# domain 通过 API 请求传入：general 或 cardiovascular（默认）
# 最小本地模式不要求 Redis/PostgreSQL 可用，服务会按代码路径降级
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# OpenAI / 兼容 API
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL（可选：留空或删除该行则跳过数据库初始化，走内存降级）
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus（向量库，免 Docker）；留空则降级为纯内存版
MILVUS_DB_PATH=milvus.db

# 语义向量模型（中文/多语言推荐 bge-m3，1024 维；有 GPU 时走 cuda）
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=

# 日志
LOG_LEVEL=INFO

# Cross-Encoder 精排（默认开启）：RRF 召回后对候选集重排序，提升检索精度
# 想关掉可设 RERANK_ENABLED=false（精排会增加单次检索延迟）
RERANK_ENABLED=true
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_CANDIDATE_K=50
# RERANK_DEVICE=

# 库外拒答门控（默认关闭）：精排 top-1 相关度低于阈值时返回「知识库暂无此信息」而非硬答。
# 阈值由 scripts/calibrate_refuse_threshold.py 校准后填入；留空/注释 = 关闭。
# 校准结论（eval_queries_full 99 条）：反例 12 条 top-1 分 max=0.368，领域内 87 条 min=0.071，
# 两分布重叠，单阈值无法完全分离。F1 最优 0.05（反例拒答 75%/领域内误拒 0%）；安全优先 0.40
# （反例拒答 100%/领域内误拒 ~14%，误拒集中在精排分 <0.40 的低证据查询，硬答本就低忠实度）。
# 医疗场景建议 0.40（宁拒勿幻觉）。RAG_REFUSE_THRESHOLD=0.40

# 搜索（百度网页搜索，国内直连、无需 Key）
# 搜索请求超时（秒），默认 8
# SEARCH_TIMEOUT=8.0
